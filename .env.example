# Supabase → Project Settings → API. Só o servidor do Next usa (sem NEXT_PUBLIC_: não vai para o navegador).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# URL pública do site (usada nos links/imagens de compartilhamento). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
